# Copy to backend/.env.local-supabase (ignored by Git) and fill with local-only values.
# The API uses the public local key and each caller's user token; never put a service key here.
FRAGILEE_ENV=local
ENV=dev
STORAGE=supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<same-local-publishable-or-anon-key-as-frontend>
SUPABASE_JWT_SECRET=<optional-local-jwt-secret-only-if-local-tokens-use-hs256>
ALLOWED_ORIGINS=http://localhost:3001
