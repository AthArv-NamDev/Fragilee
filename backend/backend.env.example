# Copy to backend/.env. Use the SAME Supabase project and public key as ../.env.local.
# Never put a service-role key in either file.
ENV=dev
STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Only needed for older Supabase projects that sign tokens with HS256.
# SUPABASE_JWT_SECRET=

# Optional local settings:
# EXPOSE_COHORT=false
# FREE_ANALYSIS_LIMIT=0
