# Copy to .env.local-supabase (ignored by Git) and fill with values from local Supabase.
# Use the local publishable key, or the local anon key if your CLI reports that format.
FRAGILEE_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local-publishable-or-anon-key>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
