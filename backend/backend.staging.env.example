# Copy to backend/.env.staging only after creating a dedicated non-Production Supabase project.
# This backend uses the authenticated user's access token and the public anon/publishable key.
# Do not add a service-role key; this application does not require one.
FRAGILEE_ENV=staging
ENV=dev
STORAGE=supabase
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=<staging-publishable-key>
ALLOWED_ORIGINS=http://localhost:3001
