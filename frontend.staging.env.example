# Copy to .env.staging.local only after creating a dedicated non-Production Supabase project.
# Use the staging project's URL and publishable/anon key. Never use a service-role key here.
FRAGILEE_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
